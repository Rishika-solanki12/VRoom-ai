vr-storytoon/backend/**/venv_gpu/
vr-storytoon/backend/**/site-packages/
vr-storytoon/backend/**/__pycache__/
vr-storytoon/backend/.env
vr-storytoon/backend/.env.*
vr-storytoon/generated/
vr-storytoon/backend/generated/
